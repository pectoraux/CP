{
  "name": "control-plane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Intelligent Digital Control Plane (CP) — modular monolith runtime. Implements frozen architecture v1.0.",
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:unit": "bun test tests/platform tests/api tests/arch",
    "test:infra": "bun test tests/infra tests/arch/infra-isolation.test.ts",
    "infra:bootstrap": "bash scripts/bootstrap-infra.sh",
    "arch:check": "bun run scripts/arch-check.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run arch:check && bun run test:unit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
